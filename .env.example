# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ====================================================
# INNOLINK TECHNOLOGIES PAYMENT GATEWAY CONFIGURATION
# ====================================================
# Payment Gateway Provider: "mock_sandbox" (default safe test mode), "razorpay", or "stripe"
PAYMENT_GATEWAY_PROVIDER="mock_sandbox"

# Gateway Public Key ID: exposed only if gateway SDK requires frontend client key
PAYMENT_GATEWAY_KEY_ID="rzp_test_innolink_sandbox_key"

# Gateway Secret Key: CRITICAL - Server-side only! Never expose to client or frontend
PAYMENT_GATEWAY_KEY_SECRET="innolink_sec_live_gateway_salt_2026_x89f"

# Gateway Webhook Secret: Used to cryptographically authenticate incoming webhooks
PAYMENT_GATEWAY_WEBHOOK_SECRET="whsec_innolink_webhook_hmac_secret_2026"

# ====================================================
# UNIFIED EMAIL NOTIFICATION CONFIGURATION (SINGLE EMAILJS TEMPLATE)
# ====================================================
# Uses ONE single EmailJS template for all three workflows (Registration, Payment, Course Access):
EMAILJS_SERVICE_ID="service_innolink"
EMAILJS_TEMPLATE_ID="template_course_key"
EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY"
EMAILJS_PRIVATE_KEY="YOUR_EMAILJS_PRIVATE_KEY"

# Single secure configuration source for Owner notification email:
OWNER_NOTIFICATION_EMAIL="karthikeyaprabhala2005@gmail.com"

