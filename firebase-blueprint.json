{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based attributes for students and mentors",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "mentor"] },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Electronics and technology educational courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mentorId": { "type": "string" },
        "mentorName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "level": { "type": "string" },
        "duration": { "type": "string" },
        "learningOutcomes": { "type": "array" },
        "isPublished": { "type": "boolean" },
        "coverImage": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["mentorId", "title", "price", "isPublished"]
    },
    "Module": {
      "title": "Module",
      "description": "Curriculum module section inside a course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "order": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["courseId", "title", "order"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Video lessons and notes in a course module",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "moduleId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string" },
        "videoUrl": { "type": "string" },
        "videoDuration": { "type": "number" },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "notes": { "type": "string" },
        "resources": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["courseId", "moduleId", "title", "order", "isPublished"]
    },
    "AISummary": {
      "title": "AISummary",
      "description": "AI-generated summaries, key concepts and revision notes reviewed by mentor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lessonId": { "type": "string" },
        "courseId": { "type": "string" },
        "summary": { "type": "string" },
        "keyConcepts": { "type": "array" },
        "importantPoints": { "type": "array" },
        "studyQuestions": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["lessonId", "courseId", "summary", "status"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student enrollment in a paid course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentEmail": { "type": "string" },
        "courseId": { "type": "string" },
        "enrolledAt": { "type": "string" },
        "paymentId": { "type": "string" },
        "accessKeyUsed": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["studentId", "courseId", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Secure record of student course payment and gateway verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentEmail": { "type": "string" },
        "studentName": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "orderId": { "type": "string" },
        "paymentId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["CREATED", "VERIFIED", "FAILED", "REJECTED"] },
        "verifiedAt": { "type": "string" },
        "emailStatus": { "type": "string", "enum": ["PENDING", "SENT", "FAILED"] },
        "courseKey": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["studentId", "courseId", "orderId", "amount", "currency", "status"]
    },
    "CourseAccessKey": {
      "title": "CourseAccessKey",
      "description": "Unique activation keys generated on verified payment or by mentors to unlock courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
        "courseId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentEmail": { "type": "string" },
        "mentorId": { "type": "string" },
        "paymentId": { "type": "string" },
        "orderId": { "type": "string" },
        "isUsed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["ACTIVE", "REDEEMED", "REVOKED", "EXPIRED"] },
        "usedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "redeemedAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["key", "courseId", "isUsed", "status"]
    },
    "Test": {
      "title": "Test",
      "description": "Evaluation tests and quizzes for modules/lessons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "moduleId": { "type": "string" },
        "lessonId": { "type": "string" },
        "mentorId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "instructions": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "passingScore": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "questions": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["courseId", "title", "passingScore", "isPublished"]
    },
    "TestAttempt": {
      "title": "TestAttempt",
      "description": "Student score and attempt details on a test",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "testId": { "type": "string" },
        "courseId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "percentage": { "type": "number" },
        "passed": { "type": "boolean" },
        "answers": { "type": "object" },
        "completedAt": { "type": "string" }
      },
      "required": ["testId", "courseId", "studentId", "score", "passed"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Practical electronics projects and homework",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "moduleId": { "type": "string" },
        "mentorId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string" },
        "maxMarks": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["courseId", "title", "maxMarks", "isPublished"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student assignment submission with mentor grading and feedback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assignmentId": { "type": "string" },
        "courseId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "content": { "type": "string" },
        "marks": { "type": "number" },
        "feedback": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "reviewed"] },
        "submittedAt": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["assignmentId", "courseId", "studentId", "status"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Student progress record across course lessons, tests, and assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "courseId": { "type": "string" },
        "completedLessons": { "type": "array" },
        "completedTests": { "type": "array" },
        "completedAssignments": { "type": "array" },
        "percentage": { "type": "number" },
        "isCompleted": { "type": "boolean" },
        "completedAt": { "type": "string" },
        "certificateId": { "type": "string" },
        "lastAccessedAt": { "type": "string" }
      },
      "required": ["studentId", "courseId", "percentage"]
    },
    "CodingLab": {
      "title": "CodingLab",
      "description": "Course-specific hands-on hardware and coding laboratory task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "board": { "type": "string", "enum": ["esp32", "arduino_uno", "rp2040_pico"] },
        "language": { "type": "string" },
        "requiredComponents": { "type": "array" },
        "instructions": { "type": "string" },
        "expectedOutput": { "type": "string" },
        "marks": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["courseId", "title", "board", "isPublished"]
    },
    "MarketplaceProduct": {
      "title": "MarketplaceProduct",
      "description": "STEM kits, electronics boards, sensors, and robotics products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "isApproved": { "type": "boolean" }
      },
      "required": ["sellerId", "title", "price", "category", "isApproved"]
    },
    "MarketplaceOrder": {
      "title": "MarketplaceOrder",
      "description": "Order placed by a student for STEM hardware kits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "orderStatus": { "type": "string" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["buyerId", "totalAmount", "orderStatus", "paymentStatus"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupons generated by mentors for students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "couponCode": { "type": "string" },
        "courseId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentEmail": { "type": "string" },
        "discountType": { "type": "string", "enum": ["PERCENTAGE", "FIXED_INR"] },
        "discountValue": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "assigned", "redeemed", "expired"] },
        "createdAt": { "type": "string" }
      },
      "required": ["couponCode", "discountType", "discountValue", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles for students and mentors"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Course catalog and metadata"
    },
    "/modules/{moduleId}": {
      "schema": { "$ref": "#/entities/Module" },
      "description": "Course curriculum modules"
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Video lessons and notes"
    },
    "/aiSummaries/{summaryId}": {
      "schema": { "$ref": "#/entities/AISummary" },
      "description": "AI summaries and study points"
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Student course enrollments"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Student verified course payments"
    },
    "/courseAccessKeys/{keyId}": {
      "schema": { "$ref": "#/entities/CourseAccessKey" },
      "description": "Course activation keys"
    },
    "/tests/{testId}": {
      "schema": { "$ref": "#/entities/Test" },
      "description": "Tests created by mentors"
    },
    "/testAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/TestAttempt" },
      "description": "Student test attempts and scores"
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Course assignments"
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Assignment submissions with mentor feedback"
    },
    "/progress/{progressId}": {
      "schema": { "$ref": "#/entities/Progress" },
      "description": "Student progress tracking per course"
    },
    "/codingLabs/{labId}": {
      "schema": { "$ref": "#/entities/CodingLab" },
      "description": "Course-specific coding and hardware labs"
    },
    "/marketplaceProducts/{productId}": {
      "schema": { "$ref": "#/entities/MarketplaceProduct" },
      "description": "STEM kit marketplace catalog"
    },
    "/marketplaceOrders/{orderId}": {
      "schema": { "$ref": "#/entities/MarketplaceOrder" },
      "description": "STEM kit purchase orders"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Discount coupons issued by mentors"
    }
  }
}
